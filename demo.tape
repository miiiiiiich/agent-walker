# VHS tape for the README demo gif — https://github.com/charmbracelet/vhs
# Record with: vhs demo.tape
Output docs/demo.gif

Set FontSize 14
Set Width 1400
Set Height 900
Set Theme "Catppuccin Mocha"
Set Padding 12

Type "agw --demo" Enter
Sleep 4s
Right Sleep 2.5s
Right Sleep 2s
Right Sleep 2.5s
Left Left Left Sleep 1.5s
Down Down Down Down Down Down Sleep 2s
Up Up Up Up Up Up Sleep 1.5s
Type "q"
Sleep 500ms
